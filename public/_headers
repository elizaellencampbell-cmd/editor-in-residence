# Cloudflare Pages headers.
# Keep the site editor and the test copies on pages.dev out of search results,
# so Google only lists www.editorinresidence.com.au.
/admin/*
  X-Robots-Tag: noindex

https://editor-in-residence.pages.dev/*
  X-Robots-Tag: noindex

https://:version.editor-in-residence.pages.dev/*
  X-Robots-Tag: noindex
