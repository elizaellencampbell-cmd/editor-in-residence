---
// EiR Radio: a spinning record dot above the bottom nav on every page.
// It reads "Now playing on EiR Radio: <playlist>". Hovering it shows that playlist's album-cover collage,
// and clicking it goes to the player on the DJ in Residence page.
// Which playlist is "on air" rotates daily. Once a visitor picks one on the DJ page, it shows theirs.
import dj from '../content/dj.json';

const list = (dj.playlists as { name: string; url: string; colour: string; collage?: string }[])
  .map((p) => ({ name: p.name, colour: p.colour, collage: p.collage || '', id: (p.url.match(/playlist\/([A-Za-z0-9]+)/) || [])[1] }))
  .filter((p) => p.id);
const first = list[0];
const onDj = Astro.url.pathname.startsWith('/dj-in-residence');
---
{first && (
  <a class="radio" id="eir-radio" href={onDj ? '#radio' : '/dj-in-residence/#radio'} data-playlists={JSON.stringify(list)}
     style={`--c:${first.colour}; --cover:url(${first.collage})`}>
    <span class="now"><span class="kicker">Now playing on EiR Radio:</span> <em class="name">{first.name}</em></span>
    <span class="disc" aria-hidden="true"><span class="cover"></span><span class="label"></span></span>
  </a>
)}

<script>
  const el = document.getElementById('eir-radio') as HTMLAnchorElement | null;
  if (el) {
    const lists: { id: string; name: string; colour: string; collage: string }[] = JSON.parse(el.dataset.playlists || '[]');
    const name = el.querySelector<HTMLElement>('.name')!;
    const show = (id: string | null) => {
      const day = Math.floor(Date.now() / 86400000);
      const p = lists.find((l) => l.id === id) || lists[day % lists.length];
      el.style.setProperty('--c', p.colour);
      el.style.setProperty('--cover', p.collage ? `url(${p.collage})` : 'none');
      name.textContent = p.name;
      el.dataset.id = p.id;
    };
    let saved: string | null = null;
    try { saved = localStorage.getItem('eir-radio'); } catch (e) {}
    show(saved);
    // The DJ page player tells the dot when someone picks a playlist.
    addEventListener('eir-radio', (e) => show((e as CustomEvent).detail));
  }
</script>

<style>
  .radio {
    position: fixed; right: 20px; bottom: calc(var(--nav-h) + 18px); z-index: 30;
    display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--navy);
  }
  .now {
    max-width: 260px; font-size: .82rem; line-height: 1.3; background: var(--lemon); padding: 6px 10px;
    box-shadow: 0 8px 20px -10px rgba(0,0,0,.5);
  }
  .kicker { font-weight: 700; }
  .now em { font-family: var(--serif); font-weight: 600; white-space: nowrap; }

  /* The dot as a record: dark grooves, a white ring and the playlist's colour as the label. It spins while on air. */
  .disc {
    position: relative; flex: none; width: 66px; height: 66px; border-radius: 50%; display: grid; place-items: center; overflow: hidden;
    background:
      radial-gradient(circle at 32% 28%, rgba(255,255,255,.28), transparent 42%),
      repeating-radial-gradient(circle, #1a1530 0 2px, #2c2352 2px 3px);
    box-shadow: 0 0 0 3px #fff, 0 0 26px 4px color-mix(in srgb, var(--c) 60%, transparent), 0 14px 30px -12px rgba(0,0,0,.6);
    animation: spin 3s linear infinite;
  }
  .label { position: relative; width: 26px; height: 26px; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 2px #fff; transition: opacity .3s; }
  /* A small white mark off-centre, so you can see the record turn. */
  .label::after { content: ''; position: absolute; width: 4px; height: 4px; border-radius: 50%; background: #fff; top: -10px; left: 50%; margin-left: -2px; }
  /* Hover: the record turns into the playlist's album covers. */
  .cover { position: absolute; inset: 0; background: var(--cover) center / cover; opacity: 0; transition: opacity .3s; }
  .radio:hover .cover, .radio:focus-visible .cover { opacity: 1; }
  .radio:hover .label, .radio:focus-visible .label { opacity: 0; }
  @keyframes spin { to { rotate: 360deg; } }
  @media (prefers-reduced-motion: reduce) { .disc { animation: none; } }

  @media (max-width: 760px) {
    .radio { right: 14px; bottom: calc(var(--nav-h) + 12px); }
    .now { display: none; }
    .disc { width: 54px; height: 54px; }
  }
</style>
