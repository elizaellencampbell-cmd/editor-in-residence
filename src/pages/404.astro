---
// Shown for any address that doesn't exist. Cloudflare Pages serves it with a proper 404 status,
// so search engines don't mistake broken links for copies of the homepage.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
---
<Base title="Page not found" description="This page doesn't exist." noindex>
  <PageHead label="404" title="This page has left the party." lede="The link may be old or mistyped. Try one of these instead." />
  <section>
    <div class="wrap">
      <p class="links404">
        <a href="/" class="text-link">Home</a>
        <a href="/writing/" class="text-link">Writing</a>
        <a href="/work-with-me/" class="text-link">Work with me</a>
        <a href="/about/" class="text-link">About</a>
      </p>
    </div>
  </section>
</Base>

<style>
  section { padding: 0 0 120px; }
  .links404 { display: flex; gap: 28px; flex-wrap: wrap; font-size: 1.1rem; }
</style>
