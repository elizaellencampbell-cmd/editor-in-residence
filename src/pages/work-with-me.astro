---
import Base from '../layouts/Base.astro';
import { site } from '../site.config.js';
// Back of book. PLACEHOLDER: services and the "what is Editor in Residence" copy get written with Liza next.
const services = [
  ['Pitch strategy and writing', 'Placeholder. What it is, who it is for, what you get.'],
  ['Brand positioning and tone of voice', 'Placeholder. What it is, who it is for, what you get.'],
  ['Content and editorial strategy', 'Placeholder. What it is, who it is for, what you get.'],
  ['Copywriting and editing', 'Placeholder. What it is, who it is for, what you get.'],
];
---
<Base title="Work with me" description="Editor in Residence: editing, content strategy and PR by Eliza Campbell.">
  <script is:inline>document.documentElement.dataset.theme = 'dark';</script>
  <div class="night-field">
    <span class="blob n1" aria-hidden="true"></span><span class="blob n2" aria-hidden="true"></span>
    <header class="hero">
      <nav class="top" aria-label="Header">
        <a href="/" class="logo-dot" aria-label="Editor in Residence, home"><span></span></a>
        <ul>
          <li><a href="/writing/">Writing</a></li>
          <li><a href="/work-with-me/" aria-current="page">Work with me</a></li>
          <li><a href="/#about">About</a></li>
          <li><a href={`mailto:${site.email}`}>Contact</a></li>
        </ul>
      </nav>
      <div class="page-title">
        <span class="eir-label">Night · Back of book</span>
        <h1>Work with me.</h1>
        <p class="lede">What is Editor in Residence? <em>Placeholder: the one-paragraph answer goes here, written together next.</em></p>
      </div>
    </header>
  </div>

  <section>
    <div class="wrap">
      <div class="svc">
        {services.map(([n, d], i) => (
          <div class="card"><span class="num">0{i + 1}</span><h2>{n}</h2><p>{d}</p></div>
        ))}
      </div>
      <p class="cta">Got a brief? <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
  </section>
</Base>

<style>
  .night-field { position: relative; overflow: hidden; isolation: isolate; background: var(--navy); color: #fff; }
  .blob { position: absolute; z-index: -1; border-radius: 50%; aspect-ratio: 1; pointer-events: none; }
  .n1 { left: 50%; top: -30%; width: 60%; background: var(--violet); filter: blur(140px); opacity: .8; }
  .n2 { left: -10%; top: 40%; width: 40%; background: var(--pink); filter: blur(150px); opacity: .45; }
  .hero { padding: 44px max(16px, 4vw) 80px; }
  .top { display: flex; justify-content: space-between; align-items: center; }
  .top ul { display: flex; gap: 34px; list-style: none; margin: 0; padding: 0; font-size: 1rem; }
  .top a { color: #fff; text-decoration: none; }
  .top ul a[aria-current='page'] { font-family: var(--serif); font-weight: 600; font-style: italic; }
  .logo-dot span { display: block; position: relative; width: 40px; aspect-ratio: 1; border-radius: 50%; background: var(--violet); box-shadow: 0 0 22px 4px color-mix(in srgb, var(--violet) 55%, transparent); }
  .logo-dot span::after { content: ''; position: absolute; inset: 22%; border-radius: 50%; background: var(--navy); }
  .page-title { margin-top: 14vh; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .page-title .eir-label { background: var(--pink); color: var(--navy); }
  h1 { margin: 0; font-size: clamp(3.4rem, 10vw, 8.5rem); color: #fff; }
  .lede { font-family: var(--serif); font-weight: 600; font-size: clamp(1.2rem, 2.2vw, 1.7rem); line-height: 1.3; max-width: 40ch; margin: 10px 0 0; }
  .lede em { opacity: .7; }
  .svc { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .card { border: 1px solid var(--line); padding: 32px; border-radius: 4px; }
  .card h2 { font-size: clamp(1.6rem, 2.6vw, 2.2rem); margin: .3em 0 .4em; }
  .card p { color: var(--muted); margin: 0; }
  .num { font: 600 .75rem/1 var(--sans); letter-spacing: .2em; color: var(--pink); }
  .cta { font-family: var(--serif); font-weight: 600; font-size: clamp(1.3rem, 2.4vw, 1.8rem); margin-top: 56px; }
  @media (max-width: 767px) {
    .top ul { gap: 14px; font-size: .84rem; }
    .svc { grid-template-columns: 1fr; }
  }
</style>
