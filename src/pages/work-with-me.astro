---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { site } from '../site.config.js';
import { linkPubs } from '../lib/pubs.js';
// Back of book: "What is an Editor in Residence?" Built to Liza's page brief (14 Nov 2026).
// A dictionary entry that turns into a sales pitch. Rosy hazy wash, Didone serif, one idea per screen.
// Photo: plain B&W landscape headshot with a crisp rounded edge, like the home About photo.
const photo = '/images/eliza-bw-a.jpg'; // Photo A, Liza's pick
const contactHref = `mailto:${site.email}?subject=${encodeURIComponent('Booking a residency')}`;
const ig = 'https://www.instagram.com/editor.inresidence/';
const keepPubs = linkPubs;
const services = [
  ['Pitches and press releases', 'written from scratch or edited from yours'],
  ['Audience analysis', 'who reads the outlet you want, and what its editors are looking for'],
  ['Tone of voice and brand positioning', ''],
  ['Content and editorial strategy', ''],
  ['Copywriting', 'social included'],
];
---
<Base title="What is an Editor in Residence?" description="Eliza Campbell, former editor of Concrete Playground, Time Out Melbourne and Halliday Wine Companion, now works with PR agencies and brands as an editor in residence.">
  <div class="rosy">
    <span class="blob r1" aria-hidden="true"></span><span class="blob r2" aria-hidden="true"></span><span class="blob r3" aria-hidden="true"></span><span class="blob r4" aria-hidden="true"></span><span class="blob r5" aria-hidden="true"></span><span class="blob r6" aria-hidden="true"></span>
    <span class="grain" aria-hidden="true"></span>

    <nav class="top" aria-label="Header">
      <a href="/" class="logo-dot" aria-label="Editor in Residence, home"><span></span></a>
      <ul class="nav-labels">
        <li><a href="/writing/">Writing</a></li>
        <li><a href="/work-with-me/" aria-current="page">Work with me</a></li>
        <li><a href="/#about">About</a></li>
        <li><a href={`mailto:${site.email}`}>Contact</a></li>
      </ul>
    </nav>

    <!-- 1. The dictionary entry -->
    <header class="entry wrap">
      <h1 class="masthead"><Logo variant="masthead" label="Editor in Residence" /></h1>
      <p class="pron">/ed·i·tuh in rez·i·dense/ <span class="sep">·</span> <i>noun</i></p>
      <hr />
      <ol class="senses">
        <li><b>1.</b> <span>Me – the editor who used to decide which pitches got published, and now helps you get yours across the line. <i>See also:</i> your editorial double agent.</span></li>
        <li><b>2.</b> <span>An editor brought in for a good time, not a long time, who arrives with a red pen and leaves behind better copy.</span></li>
        <li><b>3.</b> <span><i>informal.</i> Your freelance editor on the inside, who tells you what the desk will say before it gets the chance.</span></li>
      </ol>
      <p class="origin"><b>Origin:</b> from <i>artist in residence</i>. Less paint, more track changes.</p>
    </header>

    <!-- 2. Cover line, set like a bus-side ad -->
    <div class="strap">
      <p class="strap-line"><span class="name">Eliza Campbell</span> knows a good pitch<sup>*</sup></p>
      <p class="strap-foot"><i>(<span class="ast">*</span>and isn't afraid to ask)</i></p>
    </div>

    <!-- 3. The long definition, beside the headshot -->
    <section class="long">
      <div class="wrap long-inner">
        <div class="long-copy">
          <p class="lead">Most brands and PR agencies think getting a pitch across the line comes down to what the editor likes. They're wrong. It's about what that editor's audience likes – and it's an editor's job to know exactly what that looks like.</p>
          <p class="aside">I wish choosing pitches came down to what I personally find interesting. Wouldn't that be nice?</p>
          <p set:html={keepPubs("For the better part of a decade I sat on the other side of your inbox – at Halliday Wine Companion, Time Out Melbourne and Concrete Playground nationally – reading 80-odd pitches a day and running very few.")} />
          <p>A modern editorial team lives and dies by data and conversion. Every story has to earn maximum reach and engagement, because that's what turns into commercial opportunity. Keep that in mind every time you write a pitch.</p>
          <p>Understanding how publishing works also means understanding the limits of the team you're pitching to: how many writers they have, what they can shoot, how fast they can turn a story around. If your pitches, exclusives and assets aren't tailored to that, you're doing yourself a disservice.</p>
        </div>
        <figure class="photo">
          <img src={photo} alt="Eliza Campbell" width="1500" height="1000" loading="lazy" />
        </figure>
      </div>
      <div class="wrap">
        <blockquote class="pull">Want to know what goes on in the mind of an editor? I'll lend you mine.</blockquote>
      </div>
    </section>

    <!-- 4. The receipts: the dot does the talking -->
    <section class="receipts" id="receipts">
      <div class="wrap">
        <p class="receipts-intro" set:html={keepPubs('I took Concrete Playground from meh to cool in 18 months.<br /><em class="rcpt">The receipts:</em>')} />
        <div class="panels">

          <figure class="panel p-orchid meh" data-count>
            <div class="viz glowup" aria-hidden="true"><span class="d dull"></span><span class="arrow-r">→</span><span class="d cool"></span></div>
            <figcaption><span class="num">From meh to cool</span><span class="line">with the expertise of a professional party girl (aka me)</span></figcaption>
          </figure>

          <figure class="panel p-cobalt" data-count>
            <div class="viz grow" style="--from:1; --to:2.1" aria-hidden="true"><span class="d small"></span><span class="d big"></span></div>
            <figcaption><span class="num" data-to="4.4" data-dec="1" data-suf="M">4.4M</span><span class="line">social engagements in 18 months, up from 1.0M</span></figcaption>
          </figure>

          <figure class="panel p-violet" data-count>
            <div class="viz grow" style="--from:1; --to:4.1" aria-hidden="true"><span class="d small"></span><span class="d big"></span></div>
            <figcaption><span class="num" data-to="17" data-suf="x">17x</span><span class="line">the link clicks, from 48K to 826K</span></figcaption>
          </figure>

          <figure class="panel p-peacock" data-count>
            <div class="viz board" aria-hidden="true"><span class="d top"></span><span class="row"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></span></div>
            <figcaption><span class="num" data-to="28849" data-comma="1">28,849</span><span class="line">average views per article, the highest of any CP writer</span></figcaption>
          </figure>

          <figure class="panel p-navy" data-count>
            <div class="viz eighty" aria-hidden="true">{Array.from({ length: 80 }, (_, i) => <span class={i === 46 ? 'pick' : ''}></span>)}</div>
            <figcaption><span class="num" data-to="80" data-suf="-odd">80-odd</span><span class="line">pitches a day. I know which ones get opened.</span></figcaption>
          </figure>

          <figure class="panel p-emerald" data-count>
            <div class="viz merge" aria-hidden="true">
              <span class="m m1"><i>Sydney editor</i></span><span class="m m2"><i>Melbourne editor</i></span><span class="m m3"><i>Brisbane editor</i></span><span class="m m4"><i>Junior writer</i></span><span class="m m5"><i>Editorial director</i></span>
              <span class="one"></span>
            </div>
            <figcaption><span class="num" data-to="1">1</span><span class="line">editor doing the job of a national editorial team. <a href="#book">Want to know how?</a></span></figcaption>
          </figure>

          <figure class="panel p-fuchsia" data-count>
            <div class="viz ripple" aria-hidden="true"><span class="ring r1"></span><span class="ring r2"></span><span class="ring r3"></span><span class="d"></span></div>
            <figcaption><span class="num" data-to="143" data-suf="K">143K</span><span class="line">views on my Marco Pierre White interview, shared 1,500+ times</span></figcaption>
          </figure>

          <figure class="panel p-lagoon" data-count>
            <div class="viz grow" style="--from:1; --to:3.2" aria-hidden="true"><span class="d small"></span><span class="d big"></span></div>
            <figcaption><span class="num" data-to="919" data-suf="%">919%</span><span class="line">growth in organic pageviews at Afterpay</span></figcaption>
          </figure>

          <div class="panel signoff">
            <p>For years I was the yes (and, far more often, the no). Now I'm the double agent in your corner.</p>
          </div>
        </div>
        <p class="footnote" set:html={keepPubs('Social figures compare my first 18 months at Concrete Playground with the 18 months before.')} />
      </div>
    </section>

    <!-- 5. Contents page -->
    <section class="contents">
      <div class="wrap narrow-ish">
        <h2 class="contents-h">What a residency covers</h2>
        <ol class="toc">
          {services.map(([t, d], i) => (
            <li><a href="#book"><span class="pg">{String(i + 1).padStart(2, '0')}</span><span class="t">{t}{d && <span class="desc">, {d}</span>}</span><span class="arrow" aria-hidden="true">→</span></a></li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 7. Call to action (6. the dictionary-style gag closes the page) -->
    <section class="cta" id="book">
      <div class="wrap narrow-ish">
        <p class="cta-copy">Residencies run for three months or more, and one-off jobs are billed by the hour. Want an editor on your side of the inbox?</p>
        <p class="cta-links">Write to me at <a href={`mailto:${site.email}`}>{site.email}</a> or find me on Instagram at <a href={ig} target="_blank" rel="noopener">@editor.inresidence</a>.</p>
        <p><a class="book" href={contactHref}>Book a residency</a></p>
        <p class="gag"><b>Synonyms:</b> double agent; former gatekeeper; the one who reads it first. <b>Antonyms:</b> agency; “We are thrilled to announce”.</p>
      </div>
    </section>
  </div>
</Base>

<script is:inline>
  (function () {
    var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var panels = document.querySelectorAll('[data-count]');
    function fmt(el, v) {
      var dec = Number(el.dataset.dec || 0), s = v.toFixed(dec);
      if (el.dataset.comma) s = Math.round(v).toLocaleString('en-AU');
      return s + (el.dataset.suf || '');
    }
    function run(p) {
      p.classList.add('go');
      var n = p.querySelector('.num'); if (!n || still || !n.dataset.to) return;
      var to = Number(n.dataset.to), t0 = performance.now(), dur = 1000;
      (function step(t) {
        var k = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - k, 3);
        n.textContent = fmt(n, to * e);
        if (k < 1) requestAnimationFrame(step); else n.textContent = fmt(n, to);
      })(t0);
    }
    if (still || !('IntersectionObserver' in window)) { panels.forEach(function (p) { p.classList.add('go'); }); return; }
    document.documentElement.classList.add('anim');
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (e.isIntersecting) { run(e.target); io.unobserve(e.target); } });
    }, { threshold: .35 });
    panels.forEach(function (p) { io.observe(p); });
  })();
</script>

<style>
  /* One rainbow wash from top to bottom: the hot pink glow of the top half, then peach, lemon, mint, aqua, sky and lilac, back to blush. */
  .rosy { position: relative; overflow: hidden; isolation: isolate; color: var(--navy);
    background: linear-gradient(180deg, #ffc4df 0, #ffd3e6 700px, #ffd9c7 1500px, #fbefb6 2300px, #d9f5d8 3000px, #c9f1ec 3700px, #d6e6fa 4400px, #e5dafa 5100px, #ffd3e6 100%); }
  .rosy > * { position: relative; z-index: 2; }
  .blob { position: absolute !important; z-index: 0 !important; border-radius: 50%; aspect-ratio: 1; pointer-events: none; }
  .r1 { left: 52%; top: -260px; width: 62vw; background: var(--pink); filter: blur(150px); opacity: .6; }
  .r5 { left: 55%; top: 2500px; width: 46vw; background: var(--lemon); filter: blur(170px); opacity: .35; }
  .r6 { left: -14%; top: 4300px; width: 50vw; background: #8fb8ff; filter: blur(180px); opacity: .35; }
  .r2 { left: -18%; top: 380px; width: 48vw; background: #ffb347; filter: blur(160px); opacity: .35; }
  .r3 { left: 60%; top: 1900px; width: 46vw; background: var(--aqua); filter: blur(170px); opacity: .3; }
  .r4 { left: -10%; top: 3300px; width: 50vw; background: var(--violet); filter: blur(180px); opacity: .22; }
  .grain { position: absolute !important; inset: 0; z-index: 3 !important; mix-blend-mode: overlay; opacity: .3; pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='300' height='300'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"); }
  .pub { white-space: nowrap; }

  .top { display: flex; justify-content: space-between; align-items: center; padding: 44px max(16px, 4vw) 0; }
  .top ul { display: flex; align-items: center; list-style: none; margin: 0; padding: 0; }
  .top a { color: var(--navy); text-decoration: none; }
  .logo-dot span { display: block; position: relative; width: 40px; aspect-ratio: 1; border-radius: 50%; background: var(--aqua); box-shadow: 0 0 22px 4px color-mix(in srgb, var(--aqua) 60%, transparent); }
  .logo-dot span::after { content: ''; position: absolute; inset: 22%; border-radius: 50%; background: var(--pink); }

  /* 1. Dictionary entry */
  .entry { padding-top: 14vh; padding-bottom: 72px; max-width: 1100px; }
  .masthead { width: min(820px, 92vw); margin: 0 0 26px; color: var(--navy); }
  .pron { font-weight: 400; font-size: clamp(1.05rem, 1.8vw, 1.4rem); margin: 22px 0 0; color: var(--navy); opacity: .85; }
  .pron i { font-family: var(--serif); font-weight: 600; }
  .sep { margin: 0 .3em; }
  .entry hr { border: 0; border-top: 1px solid var(--navy); opacity: .5; margin: 26px 0 30px; }
  .senses { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; max-width: 64ch; }
  .senses li { display: grid; grid-template-columns: 2.2em 1fr; font-size: clamp(1.05rem, 1.5vw, 1.25rem); line-height: 1.5; }
  .senses b { font-weight: 700; }
  .senses i, .origin i { font-family: var(--serif); font-weight: 600; }
  .origin { margin: 28px 0 0; max-width: 64ch; font-size: 1rem; }

  /* 2. Bus-side strap */
  .strap { background: var(--lemon); color: var(--navy); padding: 30px max(16px, 4vw) 26px; text-align: center; box-shadow: 0 20px 60px -30px rgba(20,33,91,.4); }
  .strap-line { margin: 0; font: 800 clamp(1.7rem, 4.6vw, 4rem)/1.02 var(--sans); letter-spacing: -.035em; text-transform: none; }
  .strap-line .name { font-family: var(--serif); font-style: italic; font-weight: 800; letter-spacing: -.02em; }
  .strap-line sup { font-size: .5em; vertical-align: .9em; color: var(--pink); }
  .strap-foot .ast { color: var(--pink); font-style: normal; font-weight: 800; }
  .strap-foot { margin: 8px 0 0; font-family: var(--serif); font-weight: 600; font-size: clamp(1rem, 1.6vw, 1.3rem); }

  /* 3. Long definition: copy on the left, the photo melting in on the right.
     Rule of thirds: her face sits on the right-hand third line, eyes on the top third, looking into the copy. */
  .long { padding: 110px 0 100px; }
  .long-inner { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .long-copy { font-size: 1.08rem; line-height: 1.75; }
  .long-copy p { max-width: 60ch; }
  .long-copy .lead { font-family: var(--serif); font-weight: 700; font-size: clamp(1.4rem, 2.2vw, 1.85rem); line-height: 1.3; margin-top: 0; }
  .long-copy .aside { font-family: var(--serif); font-style: italic; font-weight: 600; font-size: 1.2rem; color: #3B3FD6; }
  .long-copy :global(i) { font-family: var(--serif); font-weight: 600; }
  .long-copy :global(a.pub) { color: inherit; text-decoration-color: #3B3FD6; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .long-copy :global(a.pub:hover) { color: #3B3FD6; }
  /* Plain black and white, crisp rounded edge, like the home About photo. Cropped so her face sits on a third line. */
  .photo { margin: 6px 0 0; position: sticky; top: 40px; }
  .photo img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 10px; display: block; filter: grayscale(1); box-shadow: 0 24px 60px -30px rgba(20,33,91,.45); }
  .photo img { object-position: 46% 50%; }
  .pull { margin: 80px 0 0; max-width: 20ch; font-family: var(--serif); font-weight: 800; font-size: clamp(2.1rem, 4.6vw, 4.2rem); line-height: 1.04; letter-spacing: -.02em; }
  @media (max-width: 900px) {
    .long { padding-top: 60px; }
    .long-inner { grid-template-columns: 1fr; }
    .photo { position: static; order: -1; }
    .photo img { aspect-ratio: 4 / 3; }
    .pull { margin-top: 56px; }
  }

  /* 4. Receipts */
  .receipts { padding: 40px 0 80px; }
  .receipts-intro { font-family: var(--serif); font-weight: 700; font-size: clamp(1.6rem, 3.2vw, 2.6rem); line-height: 1.15; max-width: 26ch; margin: 0 0 40px; }
  .receipts-intro :global(em) { color: #3B3FD6; white-space: nowrap; }
  .receipts-intro :global(a.pub) { color: inherit; text-decoration-color: #3B3FD6; text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .footnote :global(a.pub) { color: inherit; }
  .panels { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .panel { position: relative; overflow: hidden; isolation: isolate; margin: 0; border-radius: 6px; min-height: 380px; padding: 28px; display: flex; flex-direction: column; justify-content: space-between; gap: 24px;
    background: var(--g); color: #fff; }
  .panel::before { content: ''; position: absolute; inset: -30%; z-index: -1; filter: blur(50px);
    background: radial-gradient(circle at 85% 10%, color-mix(in srgb, var(--a1) 75%, transparent), transparent 42%), radial-gradient(circle at 10% 95%, color-mix(in srgb, var(--a2) 65%, transparent), transparent 45%); }
  .p-orchid  { --g: #A0006A;        --a1: var(--lime);   --a2: var(--pink);   --r: var(--lime);  --c: #A0006A; }
  .meh .num { font-size: clamp(2.6rem, 4.4vw, 3.8rem); line-height: 1; }
  .glowup { gap: 18px; }
  .glowup .dull { width: 46px; aspect-ratio: 1; background: #b9a7b2; filter: grayscale(1); opacity: .7; }
  .glowup .arrow-r { font: 700 1.6rem/1 var(--sans); opacity: .8; }
  .glowup .cool { width: 96px; aspect-ratio: 1; box-shadow: 0 0 44px 8px color-mix(in srgb, var(--r) 55%, transparent); transition: transform 1s cubic-bezier(.2,.8,.2,1), filter 1s; }
  :global(.anim) .glowup .cool { transform: scale(.5); filter: grayscale(1); }
  :global(.anim) .go .glowup .cool { transform: none; filter: var(--shadow); }
  .p-cobalt  { --g: var(--cobalt);  --a1: var(--pink);   --a2: var(--aqua);   --r: var(--pink);  --c: var(--lemon); }
  .p-violet  { --g: var(--violet);  --a1: var(--pink);   --a2: var(--cobalt); --r: var(--lime);  --c: var(--violet); }
  .p-peacock { --g: var(--peacock); --a1: var(--lagoon); --a2: var(--lime);   --r: var(--aqua);  --c: var(--pink); }
  .p-navy    { --g: var(--navy);    --a1: var(--violet); --a2: var(--lagoon); --r: var(--lemon); --c: var(--pink); }
  .p-emerald { --g: var(--emerald); --a1: var(--lime);   --a2: var(--aqua);   --r: var(--lemon); --c: #3B3FD6; }
  .p-fuchsia { --g: var(--fuchsia); --a1: #ffb347;       --a2: var(--violet); --r: var(--aqua);  --c: var(--navy); }
  .p-lagoon  { --g: #0D7C87;        --a1: var(--aqua);   --a2: var(--pink);   --r: var(--lemon); --c: #0D7C87; }
  .num { display: block; font-family: var(--serif); font-weight: 800; font-size: clamp(3.4rem, 6vw, 5.2rem); line-height: .95; letter-spacing: -.03em; font-variant-numeric: lining-nums tabular-nums; }
  .line { display: block; margin-top: 10px; font-size: 1rem; line-height: 1.4; max-width: 30ch; }
  .line a { color: inherit; font-weight: 700; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .viz { position: relative; height: 150px; display: flex; align-items: center; gap: 22px; }
  .d { display: block; border-radius: 50%; background: radial-gradient(circle, var(--c) 0 38%, var(--r) 39%); filter: var(--shadow); flex: none; }

  /* Before/after: sized by area. Small dot 34px; big dot 34px × (sqrt of the ratio), set per panel in --to. */
  .grow .small { width: 34px; aspect-ratio: 1; background: radial-gradient(circle, color-mix(in srgb, var(--c) 45%, #fff) 0 38%, color-mix(in srgb, var(--pink) 35%, #fff) 39%); opacity: .8; }
  .grow .big { width: calc(34px * var(--to)); aspect-ratio: 1; transition: transform 1s cubic-bezier(.2,.8,.2,1); transform-origin: left center;
    box-shadow: 0 0 40px 6px color-mix(in srgb, var(--r) 45%, transparent); }
  :global(.anim) .grow .big { transform: scale(calc(var(--from) / var(--to))); }
  :global(.anim) .go .grow .big { transform: none; }

  .board { flex-direction: column; justify-content: center; gap: 10px; }
  .board .top { width: 56px; aspect-ratio: 1; box-shadow: 0 0 36px 6px color-mix(in srgb, var(--r) 50%, transparent); }
  .board .row { display: flex; gap: 10px; }
  .board .row span { width: 18px; aspect-ratio: 1; border-radius: 50%; background: rgba(255,255,255,.35); }
  :global(.anim) .board .top { transform: translateY(40px); opacity: 0; transition: transform .9s cubic-bezier(.2,.8,.2,1), opacity .5s; }
  :global(.anim) .go .board .top { transform: none; opacity: 1; }

  .eighty { display: grid; grid-template-columns: repeat(16, 1fr); gap: 7px; align-content: center; height: 150px; }
  .eighty span { width: 100%; aspect-ratio: 1; border-radius: 50%; background: rgba(255,255,255,.28); }
  .eighty .pick { background: radial-gradient(circle, var(--c) 0 38%, var(--r) 39%); transform: scale(2.6); z-index: 1; box-shadow: 0 0 10px 2px color-mix(in srgb, var(--r) 70%, transparent); transition: transform .8s cubic-bezier(.2,.8,.2,1) .2s; }
  :global(.anim) .eighty .pick { transform: scale(1); }
  :global(.anim) .go .eighty .pick { transform: scale(2.6); }

  .merge { justify-content: space-between; }
  .m { position: relative; width: 26px; aspect-ratio: 1; border-radius: 50%; background: rgba(255,255,255,.5); transition: transform 1s cubic-bezier(.6,0,.2,1), opacity .6s .6s; }
  .m i { position: absolute; top: 100%; left: 50%; transform: translateX(-50%); margin-top: 8px; font: 500 .62rem/1.15 var(--sans); text-align: center; width: 6.5em; font-style: normal; opacity: .9; transition: opacity .4s; }
