---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Tile from '../components/Tile.astro';
import home from '../content/home.json';
import { buildTiles } from '../lib/merch.js';
import { site, categories, categoryColourways } from '../site.config.js';

// Every byline: Featured picks first, then newest first. The grid shows a page at a
// time with a "Show more" button. Category picks come first under each filter.
const tiles = buildTiles();
const counts = Object.fromEntries(categories.map((c) => [c, tiles.filter((a) => a.category === c).length]));
const outlets = 'Concrete Playground, Time Out Melbourne, Halliday Wine Companion and Broadsheet';

// Page sections, in the order set in the site editor (src/content/home.json).
const sections = home.sections || [];
const esc = (t = '') => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// Paragraph text: *italics* and [link text](https://...) are allowed.
const md = (t = '') => esc(t)
  .replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+|mailto:[^)\s]+|\/[^)\s]*)\)/g, '<a href="$2">$1</a>')
  .replace(/\*([^*]+)\*/g, '<em>$1</em>');
---
<Base description={`Food, drink, travel and lifestyle writing by Eliza Campbell for ${outlets}.`}>
  {sections.map((sec) => {
    const t = sec._template;
    if (t === 'hero') return (
      <Fragment>
        <!-- Homepage header, built to the hazy kit's 1600 × 900 recipe: aura blobs behind, crisp marks in front, grain over everything -->
        <div class="field eir-hazy">
          <span class="blob b1" aria-hidden="true"></span><span class="blob b2" aria-hidden="true"></span><span class="blob b3" aria-hidden="true"></span>
          <header class="hero">
            <nav class="top" aria-label="Header">
              <a href="/" class="logo-dot" aria-label="Editor in Residence, home"><span></span></a>
              <ul>
                <li><a href="#work">Work</a></li>
                <li><a href="#about">About</a></li>
                <li><a href={`mailto:${site.email}`}>Contact</a></li>
              </ul>
            </nav>
            <h1 class="masthead"><Logo variant="masthead" label="Editor in Residence" /></h1>
            {sec.signoff && <div class="labels hero-labels"><span class="eir-label">{sec.signoff}</span></div>}
            <p class="byline">{sec.byline}{sec.credentials && <Fragment><br /><em>{sec.credentials}</em></Fragment>}</p>
          </header>
          <h2 class="featured-title" id="work">{sec.featuredHeading || 'Featured.'}</h2>
          <div class="filters wrap" role="group" aria-label="Show writing by category">
            <button type="button" class="f on" data-cat="all" aria-pressed="true">All <span class="n">{tiles.length}</span></button>
            {categories.map((c) => (
              <button type="button" class="f" data-cat={c} aria-pressed="false"><span class="sw" data-cw={categoryColourways[c]} aria-hidden="true"></span>{c} <span class="n">{counts[c]}</span></button>
            ))}
          </div>
          <span class="grain" aria-hidden="true"></span>
        </div>

        <section class="tiles-section">
          <div class="wrap tiles" id="tiles">
            {tiles.map((a) => <Tile a={a} />)}
          </div>
          <p class="more-wrap"><button type="button" id="more" class="more-btn" hidden>Show more</button></p>
        </section>
      </Fragment>
    );
    if (t === 'about') return (
      <section class="about glow-bg" id="about">
        <div class="wrap about-inner">
          <picture class="headshot">
            <source srcset="/images/eliza-campbell.webp" type="image/webp" />
            <img src={sec.photo || '/images/eliza-campbell.jpg'} alt={sec.heading || 'Eliza Campbell'} width="800" height="1000" loading="lazy" />
          </picture>
          <div class="about-copy">
            <h2>{sec.heading}</h2>
            {sec.role && <p class="role">{sec.role}</p>}
            {(sec.paragraphs || []).map((p) => <p set:html={md(p)} />)}
            <p class="email-line">{sec.emailPrompt || 'Commissioning? Email me.'}<br /><a href={`mailto:${site.email}`} class="text-link">{site.email}</a></p>
            <p class="ig">Instagram: <a href={site.instagram} target="_blank" rel="noopener">{site.instagramHandle}</a></p>
            <div class="labels small"><span class="eir-label">{site.signoff[0]}</span></div>
          </div>
        </div>
      </section>
    );
    if (t === 'text') return (
      <section class="text-block" id={sec.anchor || undefined}>
        <div class="wrap narrow">
          {sec.label && <div class="labels small"><span class="eir-label">{sec.label}</span></div>}
          {sec.heading && <h2>{sec.heading}</h2>}
          {(sec.paragraphs || []).map((p) => <p set:html={md(p)} />)}
          {sec.buttonText && sec.buttonLink && <p><a class="more-btn" href={sec.buttonLink}>{sec.buttonText}</a></p>}
        </div>
      </section>
    );
    if (t === 'quote') return (
      <section class="quote-block">
        <div class="wrap narrow">
          <blockquote><p>“{sec.quote}”</p>{sec.by && <cite>{sec.by}</cite>}</blockquote>
        </div>
      </section>
    );
    return null;
  })}
</Base>

<script is:inline>
  (function () {
    var grid = document.getElementById('tiles');
    if (!grid) return;
    var allTiles = Array.prototype.slice.call(grid.querySelectorAll('.tile'));
    var tiles = allTiles;
    var buttons = document.querySelectorAll('.filters .f');
    var reduce = matchMedia('(prefers-reduced-motion: reduce)');
    var current = 'all';

    // Masonry: drop each visible tile into the shortest column; the third column starts lower.
    var lastN = 0;
    function layout(force) {
      var w = grid.clientWidth;
      var n = window.innerWidth > 900 ? 3 : window.innerWidth >= 560 ? 2 : 1;
      if (!force && n === lastN) return;
      lastN = n;
      grid.classList.add('js-cols');
      grid.querySelectorAll('.col').forEach(function (c) { c.remove(); });
      var cols = [];
      for (var i = 0; i < n; i++) {
        var c = document.createElement('div');
        c.className = 'col' + (n === 3 && i === 2 ? ' drop' : '');
        grid.appendChild(c);
        cols.push(c);
      }
      tiles.forEach(function (t) {
        if (t.hidden) { cols[0].appendChild(t); return; }
        var shortest = cols.reduce(function (a, b) { return b.offsetHeight + b.offsetTop < a.offsetHeight + a.offsetTop ? b : a; });
        shortest.appendChild(t);
      });
    }

    var PAGE = 36, limit = PAGE;
    var more = document.getElementById('more');
    function filter(cat, keepLimit) {
      if (!keepLimit) limit = PAGE;
      current = cat;
      // Under a category, that category's picks come first (in order), then the usual order.
      tiles = cat === 'all' ? allTiles : allTiles.slice().sort(function (a, b) {
        var ra = a.dataset.rankCat === '' ? 1e6 : Number(a.dataset.rankCat);
        var rb = b.dataset.rankCat === '' ? 1e6 : Number(b.dataset.rankCat);
        return ra - rb || allTiles.indexOf(a) - allTiles.indexOf(b);
      });
      var shown = 0, total = 0;
      tiles.forEach(function (t) {
        var match = cat === 'all' || t.dataset.category === cat;
        if (match) total++;
        t.hidden = !(match && shown < limit);
        if (!t.hidden) shown++;
      });
      more.hidden = shown >= total;
      more.textContent = 'Show more (' + (total - shown) + ' to go)';
      buttons.forEach(function (b) {
        var on = b.dataset.cat === cat;
        b.classList.toggle('on', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      layout(true);
      tiles.forEach(function (t) { if (!t.hidden) t.classList.add('in'); });
    }
    more.addEventListener('click', function () { limit += PAGE; filter(current, true); });
    buttons.forEach(function (b) {
      b.addEventListener('click', function () {
        filter(b.dataset.cat);
        history.replaceState(null, '', b.dataset.cat === 'all' ? '#work' : '#' + b.dataset.cat.toLowerCase());
      });
    });
    function fromHash() {
      var h = decodeURIComponent(location.hash.slice(1)).toLowerCase();
      var match = Array.prototype.find.call(buttons, function (b) { return b.dataset.cat.toLowerCase() === h; });
      if (match) {
        filter(match.dataset.cat);
        document.getElementById('work').scrollIntoView();
      }
    }
    window.addEventListener('hashchange', fromHash);

    // Fade tiles in as they scroll into view.
    if ('IntersectionObserver' in window && !reduce.matches) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px' });
      allTiles.forEach(function (t) { io.observe(t); });
    } else {
      allTiles.forEach(function (t) { t.classList.add('in'); });
    }

    // Photo ⇄ text card, every 3s, staggered, paused on hover/focus. Off under reduced motion.
    var paused = new Set();
    allTiles.forEach(function (t, i) {
      t.addEventListener('mouseenter', function () { paused.add(t); });
      t.addEventListener('mouseleave', function () { paused.delete(t); });
      t.addEventListener('focus', function () { paused.add(t); t.classList.add('flip'); });
      t.addEventListener('blur', function () { paused.delete(t); });
      t.dataset.offset = String((i * 7) % 10); // spread start times across the 3s cycle
    });
    var tick = 0;
    setInterval(function () {
      if (reduce.matches || document.hidden) return;
      tick = (tick + 1) % 10;
      allTiles.forEach(function (t) {
        if (paused.has(t) || !t.classList.contains('has-photo')) return;
        if (Number(t.dataset.offset) === tick) t.classList.toggle('flip');
      });
    }, 300);

    filter('all');
    fromHash();
    var rt;
    window.addEventListener('resize', function () { clearTimeout(rt); rt = setTimeout(function () { layout(false); }, 120); });
    // Re-balance once images have their final size.
    window.addEventListener('load', function () { layout(true); });
  })();
</script>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .eir-hazy { position: relative; overflow: hidden; isolation: isolate; padding-bottom: 34vh;
    -webkit-mask-image: linear-gradient(#000 calc(100% - 34vh), transparent); mask-image: linear-gradient(#000 calc(100% - 34vh), transparent); }
  .eir-hazy > * { position: relative; z-index: 2; }
  .blob { position: absolute !important; z-index: 0 !important; border-radius: 50%; aspect-ratio: 1; pointer-events: none; }
  .b1 { left: -16%; top: 18%; width: 56%; background: var(--a1); filter: blur(130px); opacity: .95; }
  .b2 { left: 56%;  top: -14%; width: 50%; background: var(--a2); filter: blur(140px); opacity: .75; }
  .b3 { left: 72%;  top: 34%;  width: 39%; background: var(--a3); filter: blur(140px); opacity: .7; }
  .grain { position: absolute !important; inset: 0; z-index: 3 !important; mix-blend-mode: overlay; opacity: .35; pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='300' height='300'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"); }

  .hero {
    min-height: min(100svh, 900px);
    display: flex; flex-direction: column; color: var(--fg);
    padding: 44px max(16px, 4vw) 72px;
  }
  .top { display: flex; justify-content: space-between; align-items: center; }
  .top ul { display: flex; gap: 34px; list-style: none; margin: 0; padding: 0; font-size: 1rem; }
  .top a { color: #fff; text-decoration: none; }
  .top ul a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .logo-dot span { display: block; position: relative; width: 40px; aspect-ratio: 1; border-radius: 50%; background: var(--ring);
    box-shadow: 0 0 22px 4px color-mix(in srgb, var(--ring) 55%, transparent); }
  .logo-dot span::after { content: ''; position: absolute; inset: 22%; border-radius: 50%; background: #fff; }
  .masthead { width: min(820px, 92vw); margin: 18vh 0 0; color: #fff; }
  .hero-labels { margin-top: 34px; }
  .byline { margin: 30px 0 0; max-width: 52ch; font-size: 1rem; line-height: 1.5; color: #fff; }
  .byline em { font-family: var(--serif); font-size: 1.08em; }
  @media (max-width: 767px) {
    .top ul { gap: 20px; font-size: .9rem; }
    .masthead { margin-top: 30vh; }
  }
  .featured-title { text-align: center; margin: 0; padding: 40px 0 0; font-size: clamp(3rem, 7vw, 5.5rem); scroll-margin-top: 24px; }

  .filters { display: flex; justify-content: center; flex-wrap: wrap; gap: 4px 26px; padding-top: 18px; padding-bottom: 8px; }
  .f {
    font: inherit; font-family: var(--sans); font-weight: 600; font-size: .74rem; letter-spacing: .16em; text-transform: uppercase;
    cursor: pointer; background: none; border: 0; border-bottom: 1px solid transparent; color: var(--fg); opacity: .8; padding: 6px 0; display: inline-flex; align-items: center; gap: 8px;
  }
  .f:hover { opacity: 1; }
  .f.on { opacity: 1; border-bottom-color: currentColor; }
  .n { opacity: .7; font-weight: 500; }
  .more-wrap { text-align: center; margin: 24px 0 0; }
  .more-btn { font: 700 1rem/1 var(--sans); padding: 14px 22px; border: 0; cursor: pointer; background: var(--lbg); color: var(--lfg); filter: var(--shadow); }
  .more-btn:hover { background: var(--ring); color: #fff; }
  .sw { width: 11px; height: 11px; border-radius: 50%; background: radial-gradient(circle, var(--centre) 0 38%, var(--ring) 40%); }

  .tiles-section { padding-top: 0; margin-top: -30vh; position: relative; z-index: 2; }
  .tiles { padding-left: clamp(16px, 5vw, 65px); padding-right: clamp(16px, 5vw, 65px); max-width: 1280px; }

  .about-inner { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 80px); align-items: center; }
  .headshot img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 10px; display: block; }
  .about-copy { min-width: 0; }
  .about-copy h2 { font-size: clamp(2.6rem, 5vw, 4rem); margin-bottom: .2em; }
  .role { font-weight: 700; margin-bottom: 1.6em; }
  .about-copy p { max-width: 60ch; }
  .email-line { font-family: var(--serif); font-size: clamp(1.3rem, 2.4vw, 1.8rem); line-height: 1.3; margin-top: 1.4em; }
  .email-line a { overflow-wrap: anywhere; }
  .ig a { color: var(--accent); }
  .about-copy .labels { margin-top: 28px; }
  @media (max-width: 860px) { .about-inner { grid-template-columns: 1fr; } }
  .text-block .narrow, .quote-block .narrow { max-width: 760px; }
  .text-block h2 { font-size: clamp(2.2rem, 4.4vw, 3.4rem); margin: .3em 0 .4em; }
  .text-block p { max-width: 62ch; }
  .text-block .more-btn { display: inline-block; text-decoration: none; margin-top: .6em; }
  .quote-block blockquote { margin: 0; text-align: center; }
  .quote-block blockquote p { font-family: var(--serif); font-style: italic; font-size: clamp(1.6rem, 3.4vw, 2.6rem); line-height: 1.25; margin: 0; }
  .quote-block cite { display: block; margin-top: 1em; font-style: normal; font-size: .8rem; letter-spacing: .16em; text-transform: uppercase; }
</style>
