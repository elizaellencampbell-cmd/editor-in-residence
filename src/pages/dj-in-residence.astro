---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { site } from '../site.config.js';
// DJ in Residence: playlists, each one a dot. The colourway is what the music looks like (synaesthesia).
// MOCKUP: names and moods are working titles; Liza will merch real playlists (Spotify links/embeds) later.
// Real playlists come from src/content/dj.json (Merch DJ Notion board): { name, url, colour (hex, dot centre), description, collage (image of album covers) }.
// Until it has entries, the placeholder colourways below show.
import dj from '../content/dj.json';
const placeholders = [
  { cw: 'Hot pink', g: '#FF3EA5', ring: '#14215B', centre: '#fff', fg: 'navy', name: 'Pre-drinks', mood: 'Getting ready with the door open and the volume up.' },
  { cw: 'Nudibranch', g: '#3b3fd6', ring: '#F2E21C', centre: '#3b3fd6', fg: 'white', name: 'Sunday slow-down', mood: 'Coffee, the papers and nowhere to be.' },
  { cw: 'Night Violet', g: '#2c2352', ring: '#3FD9C8', centre: '#FF3EA5', fg: 'white', name: 'After midnight', mood: 'For the walk home that takes the long way.' },
  { cw: 'Electric Violet', g: '#6A2BD9', ring: '#C6F03A', centre: '#6A2BD9', fg: 'white', name: 'Dance floor', mood: 'No skips, no sitting down.' },
  { cw: 'Orchid', g: '#a1006a', ring: '#C6F03A', centre: '#a1006a', fg: 'white', name: 'Long lunch', mood: 'Another bottle? Go on, then.' },
  { cw: 'Peacock', g: '#05535C', ring: '#FF3EA5', centre: '#3FD9C8', fg: 'white', name: 'Coast road', mood: 'Windows down, somewhere past Geelong.' },
  { cw: 'Cobalt', g: '#2350E6', ring: '#FF3EA5', centre: '#fff', fg: 'white', name: 'Deadline', mood: 'Head down, headphones on, copy due at five.' },
  { cw: 'Navy and lemon', g: '#14215B', ring: '#F2E21C', centre: '#14215B', fg: 'white', name: 'Golden hour', mood: 'The first warm evening of the year.' },
  { cw: 'Emerald', g: '#0E8A5F', ring: '#F2E21C', centre: '#0E8A5F', fg: 'white', name: 'Garden party', mood: 'Spritzes, sunburn and a borrowed speaker.' },
];
const real = dj.playlists.map((p) => ({ cw: '', g: '#2c2352', ring: '#fff', centre: p.colour, fg: 'white', name: p.name, mood: p.description || '', url: p.url, collage: p.collage }));
const lists = real.length ? real : placeholders;
const radio = dj.playlists.map((p) => ({ name: p.name, colour: p.colour, id: (p.url.match(/playlist\/([A-Za-z0-9]+)/) || [])[1] })).filter((p) => p.id);
---
<Base title="DJ in Residence" description="Playlists by Eliza Campbell, each one a colour.">
  <div class="night">
    <span class="blob d1" aria-hidden="true"></span><span class="blob d2" aria-hidden="true"></span><span class="blob d3" aria-hidden="true"></span><span class="blob d4" aria-hidden="true"></span><span class="blob d5" aria-hidden="true"></span>
    <span class="grain" aria-hidden="true"></span>

    <nav class="top" aria-label="Header">
      <a href="/" class="logo-dot" aria-label="Editor in Residence, home"><span></span></a>
      <ul class="nav-labels">
        <li><a href="/">Editor in Residence</a></li>
        <li><a href="/artist-in-residence/">Artist in Residence</a></li>
        <li><a href="/dj-in-residence/" aria-current="page">DJ in Residence</a></li>
        <li><a href={`mailto:${site.email}`}>Contact</a></li>
      </ul>
    </nav>

    <header class="intro wrap">
      <h1 class="masthead"><Logo variant="dj" label="DJ in Residence" /></h1>
      <p class="stack">
        <span class="eir-label dj">By Eliza Campbell.</span>
        <span class="lede">Fun fact: I have chromesthesia. I hear in colour.</span>
      </p>
      <p class="how">Not just music, either. Venues, countries, drinks and people all come in a colour. If we've met, I know what colour you are (and I'll tell you if you ask nicely).</p>
      <p class="how">So every playlist here gets its own dot: the ground, the ring and the centre are what it looks like to me. Pick a colour, press play.</p>
    </header>

    {radio.length > 0 && (
      <section class="wrap player" id="radio" aria-labelledby="radio-h" data-playlists={JSON.stringify(radio)}>
        <div class="player-side">
          <h2 id="radio-h">EiR Radio.</h2>
          <p class="on-air">Now playing on EiR Radio: <em class="on-name">{radio[0].name}</em></p>
          <ul class="tune" aria-label="Change the station">
            {radio.map((p) => (
              <li><button type="button" data-radio={p.id} title={p.name} aria-label={p.name} style={`--c:${p.colour}`}></button></li>
            ))}
          </ul>
          <p class="hint">Not signed in to Spotify? You'll hear 30-second previews.</p>
        </div>
        <iframe class="embed" title="EiR Radio on Spotify" src={`https://open.spotify.com/embed/playlist/${radio[0].id}?utm_source=generator`}
          width="100%" height="452" frameborder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
      </section>
    )}

    <section class="wrap" aria-label="Playlists">
      <ul class="lists">
        {lists.map((l) => (
          <li class={`pl fg-${l.fg} ${l.collage ? 'has-collage' : ''}`} style={`--g:${l.g};--ring:${l.ring};--centre:${l.centre}${l.collage ? `;--collage:url(${l.collage})` : ''}`}>
            <span class="glowdot" aria-hidden="true"><span class="glow"></span><span class="dot"></span></span>
            {l.cw && <span class="cw">{l.cw}</span>}
            <h2>{l.name}</h2>
            {l.mood && <p class="mood">{l.mood}</p>}
            <p class="acts">
              {l.url && <button type="button" class="listen radio-play" data-radio={(l.url.match(/playlist\/([A-Za-z0-9]+)/) || [])[1]}>Play on EiR Radio</button>}
              <a class="listen alt" href={l.url || '#'} target={l.url ? '_blank' : undefined} rel="noopener">Listen on Spotify</a>
            </p>
          </li>
        ))}
      </ul>
      {!real.length && <p class="note">Working titles. Real playlists to come.</p>}
    </section>

    <section class="brands wrap" aria-labelledby="brands-h">
      <h2 id="brands-h">Music for brands.</h2>
      <p class="brands-lede">Music is the fastest way to tell people how to feel about you. Get it right and people linger, spend and remember the room. Get it wrong and you're the shop playing the same twelve songs on loop.</p>
      <ul class="uses">
        <li class="u-lemon"><h3>In store</h3><p>Playlists built for your space and your pace: slow for browsing, quicker when you need the foot traffic moving.</p></li>
        <li class="u-aqua"><h3>On social</h3><p>TikTok and Reels are sound-on. I'll find the track that stops the scroll and still sounds like the brand.</p></li>
        <li class="u-pink"><h3>Launches and PR</h3><p>Launch nights, long tables and listening parties, scored to the brand's colour. A sonic identity, minus the jingle.</p></li>
        <li class="u-lime"><h3>The vibe, before the visit</h3><p>Let people hear the room before they book. A playlist link in the press kit, or a public Spotify profile for your venue with playlists people can follow (Gap does this really well). By the time they walk in, they already know the mood.</p></li>
      </ul>
      <p class="fine">Playing music in a shop or venue needs a business music licence, not a personal Spotify account. I'll point you to the right one.</p>
    </section>

    <section class="cta wrap">
      <p class="cta-copy">Need a soundtrack for a launch, a long table or a shopfront?</p>
      <p class="cta-links">Write to me at <a href={`mailto:${site.email}?subject=${encodeURIComponent('DJ in Residence')}`}>{site.email}</a>.</p>
    </section>
  </div>
</Base>

<script>
  // EiR Radio player: tune with the dots or a card's "Play on EiR Radio". The choice is remembered for the dot in the corner.
  const player = document.getElementById('radio');
  if (player) {
    const lists: { id: string; name: string; colour: string }[] = JSON.parse(player.dataset.playlists || '[]');
    const frame = player.querySelector<HTMLIFrameElement>('.embed')!;
    const onName = player.querySelector<HTMLElement>('.on-name')!;
    const tune = (id: string, scroll = false) => {
      const p = lists.find((l) => l.id === id);
      if (!p) return;
      if (!frame.src.includes(id)) frame.src = `https://open.spotify.com/embed/playlist/${id}?utm_source=generator`;
      onName.textContent = p.name;
      player.style.setProperty('--c', p.colour);
      player.querySelectorAll<HTMLButtonElement>('.tune button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.radio === id)));
      try { localStorage.setItem('eir-radio', id); } catch (e) {}
      dispatchEvent(new CustomEvent('eir-radio', { detail: id }));
      if (scroll) player.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };
    let start: string | null = null;
    try { start = localStorage.getItem('eir-radio'); } catch (e) {}
    const day = Math.floor(Date.now() / 86400000);
    tune(lists.some((l) => l.id === start) ? start! : lists[day % lists.length].id);
    document.querySelectorAll<HTMLButtonElement>('[data-radio]').forEach((b) =>
      b.addEventListener('click', () => tune(b.dataset.radio!, !b.closest('.tune'))));
  }
</script>

<style>
  .player { --c: #fff; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 40px; align-items: center; margin-top: 70px; margin-bottom: 30px; }
  .player h2 { margin: 0 0 10px; font-size: clamp(2.4rem, 5vw, 4rem); }
  .on-air { margin: 0 0 20px; font-size: 1.1rem; }
  .on-air em { font-family: var(--serif); font-weight: 600; color: var(--c); }
  .tune { list-style: none; margin: 0 0 16px; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .tune button { width: 30px; height: 30px; border-radius: 50%; border: 0; padding: 0; cursor: pointer;
    background: radial-gradient(circle, var(--c) 0 38%, #fff 40% 52%, #1a1530 54%); transition: transform .2s; }
  .tune button:hover { transform: scale(1.15); }
  .tune button[aria-pressed='true'] { box-shadow: 0 0 0 3px #fff, 0 0 18px 4px var(--c); }
  .hint { margin: 0; font-size: .82rem; opacity: .65; }
  .embed { display: block; border: 0; border-radius: 12px; box-shadow: 0 30px 60px -30px rgba(0,0,0,.7), 0 0 60px -10px color-mix(in srgb, var(--c) 45%, transparent); }
  @media (max-width: 900px) { .player { grid-template-columns: 1fr; gap: 24px; } }

  .night { position: relative; overflow: hidden; isolation: isolate; color: #fff; padding-bottom: 100px;
    background: linear-gradient(180deg, #2c2352 0, #241d47 900px, #1d2a5e 1800px, #2c2352 100%); }
  .night > * { position: relative; z-index: 2; }
  .blob { position: absolute !important; z-index: 0 !important; border-radius: 50%; aspect-ratio: 1; pointer-events: none; }
  .d1 { left: 52%; top: -260px; width: 60vw; background: #FF3EA5; filter: blur(170px); opacity: .35; }
  .d2 { left: -18%; top: 500px; width: 50vw; background: #3FD9C8; filter: blur(170px); opacity: .25; }
  .d3 { left: 60%; top: 1200px; width: 44vw; background: #6A2BD9; filter: blur(160px); opacity: .5; }
  .d4 { left: -8%; top: 1900px; width: 46vw; background: #2350E6; filter: blur(180px); opacity: .4; }
  .d5 { left: 40%; top: 2500px; width: 40vw; background: #C6F03A; filter: blur(170px); opacity: .18; }
  .grain { position: absolute !important; inset: 0; z-index: 3 !important; mix-blend-mode: overlay; opacity: .3; pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='300' height='300'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"); }

  .top { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 44px max(16px, 4vw) 0; }
  .logo-dot span { display: block; position: relative; width: 40px; aspect-ratio: 1; border-radius: 50%; background: #3FD9C8; box-shadow: 0 0 22px 4px color-mix(in srgb, #3FD9C8 60%, transparent); }
  .logo-dot span::after { content: ''; position: absolute; inset: 22%; border-radius: 50%; background: #FF3EA5; }

  .intro { padding-top: 12vh; padding-bottom: 40px; }
  .masthead { width: min(820px, 92vw); margin: 0 0 26px; color: #fff; }
  .stack { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; margin: 0; }
  .dj { --lbg: var(--aqua); --lfg: var(--navy); font-size: clamp(1rem, 1.6vw, 1.3rem); }
  .lede { font-family: var(--serif); font-style: italic; font-weight: 600; font-size: clamp(1.3rem, 2.2vw, 1.8rem); max-width: 36ch; }
  .how { margin: 16px 0 0; max-width: 58ch; font-size: 1.08rem; line-height: 1.6; opacity: .9; }

  .lists { list-style: none; margin: 30px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 1200px) { .uses { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .pl { position: relative; overflow: hidden; isolation: isolate; border-radius: 6px; background: var(--g); padding: 30px 26px 28px; display: flex; flex-direction: column; align-items: flex-start; min-height: 420px; box-shadow: 0 30px 60px -30px rgba(0,0,0,.6); }
  /* Real playlists: a collage of the playlist's album covers behind, darkened so white type holds */
  .pl.has-collage { background: linear-gradient(rgba(20,16,40,.35), rgba(20,16,40,.82)), var(--collage) center / cover; }
  .pl.fg-white { color: #fff; } .pl.fg-navy { color: var(--navy); }
  .glowdot { position: relative; width: 150px; aspect-ratio: 1; margin: 6px 0 auto; transition: transform .4s cubic-bezier(.2,.8,.2,1); }
  .glow { position: absolute; inset: 0; border-radius: 50%; background: var(--ring); filter: blur(60px); opacity: .9; transition: background .4s, transform .4s; }
  .dot { position: absolute; inset: 0; border-radius: 50%; background: var(--ring); }
  .dot::after { content: ''; position: absolute; inset: 22%; border-radius: 50%; background: var(--centre); }
  .pl:hover .glowdot { transform: scale(1.06); }
  .pl:hover .glow { background: #fff; transform: scale(1.25); }
  .cw { margin-top: 26px; font: 700 .78rem/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; opacity: .85; }
  .pl h2 { margin: 8px 0 6px; font-size: clamp(1.8rem, 2.6vw, 2.4rem); line-height: 1.05; }
  .pl:hover h2 { font-style: italic; }
  .mood { margin: 0 0 18px; line-height: 1.5; max-width: 30ch; }
  .acts { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
  button.listen { border: 0; cursor: pointer; }
  .listen.alt { background: transparent; color: inherit; box-shadow: inset 0 0 0 1.5px currentColor; filter: none; }
  .listen { display: inline-block; font: 700 .9rem/1 var(--sans); padding: .6em .85em; background: #fff; color: var(--navy); text-decoration: none; filter: var(--shadow); }
  .note { margin: 18px 0 0; font-family: var(--serif); font-style: italic; font-weight: 600; opacity: .8; }

  .brands { padding-top: 110px; }
  .brands h2 { margin: 0 0 16px; font-size: clamp(2.4rem, 5vw, 4rem); }
  .brands-lede { max-width: 58ch; font-size: 1.12rem; line-height: 1.6; margin: 0 0 28px; }
  .uses { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 1200px) { .uses { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .uses li { border-radius: 6px; padding: 26px 24px 24px; color: var(--navy); box-shadow: 0 30px 60px -30px rgba(0,0,0,.6); }
  .uses h3 { margin: 0 0 10px; font-size: clamp(1.5rem, 2.2vw, 2rem); }
  .uses p { margin: 0; line-height: 1.55; }
  .u-lemon { background: var(--lemon); } .u-aqua { background: var(--aqua); } .u-pink { background: var(--pink); } .u-lime { background: var(--lime); }
  .fine { margin: 18px 0 0; font-size: .92rem; opacity: .8; max-width: 60ch; }
  @media (max-width: 900px) { .uses { grid-template-columns: 1fr; } }

  .cta { padding-top: 100px; }
  .cta-copy { font-family: var(--serif); font-weight: 700; font-size: clamp(1.6rem, 3vw, 2.5rem); line-height: 1.2; max-width: 26ch; margin: 0 0 14px; }
  .cta-links { font-size: 1.08rem; }
  .cta-links a { color: #fff; font-weight: 700; text-decoration-color: var(--aqua); text-decoration-thickness: 2px; text-underline-offset: 3px; overflow-wrap: anywhere; }

  @media (max-width: 1000px) { .lists { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .lists { grid-template-columns: 1fr; } .pl { min-height: 0; } .glowdot { width: 120px; margin-bottom: 0; } }
</style>
