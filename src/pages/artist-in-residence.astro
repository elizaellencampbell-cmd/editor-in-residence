---
import Base from '../layouts/Base.astro';
import { site } from '../site.config.js';
// Artist in Residence: Liza's photography and creative direction.
// MOCKUP: the photos and projects below are placeholders until Liza sends her own.
// Night-leaning wash (violet, aqua, lime) so it reads as its own flavour beside the pink Writing and rainbow Work with me pages.
const photos = [
  { cw: 'cobalt', shape: 'tall', label: 'Food' },
  { cw: 'hotpink', shape: 'wide', label: 'Interiors' },
  { cw: 'peacock', shape: 'square', label: 'Travel' },
  { cw: 'violet', shape: 'square', label: 'Portraits' },
  { cw: 'emerald', shape: 'tall', label: 'Drinks' },
  { cw: 'sky', shape: 'wide', label: 'Travel' },
  { cw: 'navy', shape: 'square', label: 'Food' },
  { cw: 'hotpink', shape: 'square', label: 'Cities' },
  { cw: 'cobalt', shape: 'wide', label: 'Nightlife' },
  { cw: 'violet', shape: 'wide', label: 'Rooms' },
];
const projects = [
  { cw: 'violet', title: 'Project name', who: 'Client or publication', role: 'Creative direction, styling, photography' },
  { cw: 'peacock', title: 'Project name', who: 'Client or publication', role: 'Art direction, shot list, casting' },
  { cw: 'hotpink', title: 'Project name', who: 'Client or publication', role: 'Concept, mood board, on-set direction' },
];
---
<Base title="Artist in Residence" description="Photography and creative direction by Eliza Campbell.">
  <div class="night">
    <span class="blob n1" aria-hidden="true"></span><span class="blob n2" aria-hidden="true"></span><span class="blob n3" aria-hidden="true"></span><span class="blob n4" aria-hidden="true"></span>
    <span class="grain" aria-hidden="true"></span>

    <nav class="top" aria-label="Header">
      <a href="/" class="logo-dot" aria-label="Editor in Residence, home"><span></span></a>
      <ul class="nav-labels">
        <li><a href="/writing/">Writing</a></li>
        <li><a href="/work-with-me/">Work with me</a></li>
        <li><a href="/artist-in-residence/" aria-current="page">Artist in Residence</a></li>
        <li><a href="/#about">About</a></li>
        <li><a href={`mailto:${site.email}`}>Contact</a></li>
      </ul>
    </nav>

    <header class="entry wrap">
      <h1 class="headword">art<span class="md">·</span>ist in res<span class="md">·</span>i<span class="md">·</span>dence</h1>
      <p class="pron">/ah·tist in rez·i·dense/ <span class="sep">·</span> <i>noun</i></p>
      <ol class="senses">
        <li><b>1.</b> <span>Me, behind the camera: the plates, rooms, cities and people I photograph when I'm not writing about them.</span></li>
        <li><b>2.</b> <span>The person who decides how a story looks as well as how it reads: the concept, the mood board, the shot list and the call on set.</span></li>
      </ol>
      <p class="origin"><b>Origin:</b> the original. <i>Editor in Residence</i> borrowed the idea; this page gives it back.</p>
    </header>

    <section class="block wrap" id="photography">
      <div class="head">
        <h2>Photography</h2>
        <span class="eir-label tag">Placeholder: your photos go here</span>
      </div>
      <div class="gallery">
        {photos.map((p) => (
          <figure class={`ph ${p.shape}`} data-cw={p.cw}>
            <span class="vert">{p.label}</span>
          </figure>
        ))}
      </div>
    </section>

    <section class="block wrap" id="creative-direction">
      <div class="head">
        <h2>Creative direction</h2>
        <span class="eir-label tag">Placeholder: your projects go here</span>
      </div>
      <div class="projects">
        {projects.map((p, i) => (
          <article class="proj">
            <div class="cover" data-cw={p.cw}><span class="pg">{String(i + 1).padStart(2, '0')}</span></div>
            <h3>{p.title}</h3>
            <p class="who">{p.who}</p>
            <p class="role">{p.role}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="cta wrap">
      <p class="cta-copy">Need a story that looks as good as it reads?</p>
      <p class="cta-links">Write to me at <a href={`mailto:${site.email}?subject=${encodeURIComponent('Creative direction')}`}>{site.email}</a> or see more on Instagram at <a href={site.instagram} target="_blank" rel="noopener">{site.instagramHandle}</a>.</p>
    </section>
  </div>
</Base>

<style>
  .night { position: relative; overflow: hidden; isolation: isolate; color: var(--navy); padding-bottom: 100px;
    background: linear-gradient(180deg, #d9ccff 0, #e5dafa 800px, #c9f1ec 1800px, #e6f7c4 2800px, #f3eaff 100%); }
  .night > * { position: relative; z-index: 2; }
  .blob { position: absolute !important; z-index: 0 !important; border-radius: 50%; aspect-ratio: 1; pointer-events: none; }
  .n1 { left: 50%; top: -280px; width: 62vw; background: var(--violet); filter: blur(160px); opacity: .45; }
  .n2 { left: -16%; top: 500px; width: 48vw; background: var(--aqua); filter: blur(160px); opacity: .4; }
  .n3 { left: 58%; top: 1600px; width: 46vw; background: var(--lime); filter: blur(170px); opacity: .35; }
  .n4 { left: -10%; top: 2600px; width: 50vw; background: var(--pink); filter: blur(180px); opacity: .2; }
  .grain { position: absolute !important; inset: 0; z-index: 3 !important; mix-blend-mode: overlay; opacity: .3; pointer-events: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='300' height='300'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>"); }

  .top { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 44px max(16px, 4vw) 0; }
  .logo-dot span { display: block; position: relative; width: 40px; aspect-ratio: 1; border-radius: 50%; background: var(--lime); box-shadow: 0 0 22px 4px color-mix(in srgb, var(--lime) 60%, transparent); }
  .logo-dot span::after { content: ''; position: absolute; inset: 22%; border-radius: 50%; background: var(--violet); }

  .entry { padding-top: 12vh; padding-bottom: 60px; max-width: 1100px; }
  .headword { font-family: var(--serif); font-weight: 800; font-size: clamp(3rem, 9vw, 8rem); line-height: .95; letter-spacing: -.03em; margin: 0; }
  .md { font-weight: 400; opacity: .45; }
  .pron { font-size: clamp(1.05rem, 1.8vw, 1.4rem); margin: 22px 0 26px; opacity: .85; }
  .pron i, .senses i, .origin i { font-family: var(--serif); font-weight: 600; }
  .sep { margin: 0 .3em; }
  .senses { list-style: none; margin: 0; padding: 26px 0 0; border-top: 1px solid rgba(20, 33, 91, .4); display: grid; gap: 18px; max-width: 64ch; }
  .senses li { display: grid; grid-template-columns: 2.2em 1fr; font-size: clamp(1.05rem, 1.5vw, 1.25rem); line-height: 1.5; }
  .origin { margin: 28px 0 0; max-width: 64ch; }

  .block { padding-top: 80px; }
  .head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 26px; }
  .head h2 { margin: 0; font-size: clamp(2.4rem, 5vw, 4rem); }
  .tag { --lbg: var(--violet); --lfg: #fff; font-size: .8rem; }

  .gallery { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: 200px; grid-auto-flow: dense; gap: 16px; }
  .ph { position: relative; margin: 0; border-radius: 10px; overflow: hidden; background: var(--g); box-shadow: 0 24px 60px -30px rgba(20, 33, 91, .45); }
  .ph::before { content: ''; position: absolute; inset: -30%; filter: blur(40px); background: radial-gradient(circle at 80% 15%, var(--a1), transparent 45%), radial-gradient(circle at 15% 90%, var(--a2), transparent 45%); opacity: .8; }
  .ph.tall { grid-row: span 2; }
  .ph.wide { grid-column: span 2; }
  .vert { position: absolute; left: 12px; top: 12px; font: 700 .72rem/1 var(--sans); letter-spacing: .08em; text-transform: uppercase; padding: .45em .6em; background: var(--lbg); color: var(--lfg); filter: var(--shadow); }

  .projects { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .proj h3 { margin: 16px 0 4px; font-size: clamp(1.4rem, 2.2vw, 1.9rem); }
  .proj .who { margin: 0; font-family: var(--serif); font-style: italic; font-weight: 600; }
  .proj .role { margin: 6px 0 0; font-size: .95rem; opacity: .85; }
  .cover { position: relative; aspect-ratio: 4 / 5; border-radius: 6px; overflow: hidden; background: var(--g); }
  .cover::before { content: ''; position: absolute; inset: -30%; filter: blur(40px); background: radial-gradient(circle at 80% 15%, var(--a1), transparent 45%), radial-gradient(circle at 15% 90%, var(--a2), transparent 45%); opacity: .8; }
  .pg { position: absolute; left: 18px; bottom: 10px; font: 800 4.5rem/1 var(--serif); color: #fff; text-shadow: 0 2px 20px rgba(20, 33, 91, .3); }

  .cta { padding-top: 100px; }
  .cta-copy { font-family: var(--serif); font-weight: 700; font-size: clamp(1.6rem, 3vw, 2.5rem); line-height: 1.2; max-width: 26ch; margin: 0 0 14px; }
  .cta-links { font-size: 1.08rem; max-width: 56ch; }
  .cta-links a { color: #3B3FD6; font-weight: 700; text-decoration-thickness: 2px; text-underline-offset: 3px; overflow-wrap: anywhere; }

  @media (max-width: 900px) { .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 150px; } .projects { grid-template-columns: 1fr; } }
</style>
